PGM
/*ON DÉCLARE LE FICHIER ÉCRAN (DSPF) */
             DCLF       FILE(ROUAUD/ECRAN)

/*ON DÉCLARE LES VARIABLES */
      /*VARIABLE USER */
             DCL        VAR(&USER) TYPE(*CHAR) LEN(10)
      /*VARIABLE DEST POUR DÉFINIR OU SE TROUVERA LE FICHIER DE SAV */
             DCL        VAR(&DEST) TYPE(*CHAR) LEN(50)
      /*VARIABLE DIR POUR DÉFINIR LE CHEMIN DU DOSSIER */
             DCL        VAR(&DIR) TYPE(*CHAR) LEN(50)
      /*VARIABLE DATE */
             DCL        VAR(&DATE) TYPE(*CHAR) LEN(6)
      /*VARIABLE SAVENAME POUR LE NOM DU FICHIER */
             DCL        VAR(&SAVENAME) TYPE(*CHAR) LEN(21)

      /*ON MET L'INPUT SAVLIB DE L'ÉCRAN VIDE */
 LOOP:       CHGVAR     VAR(&SAVBIB) VALUE(' ')
      /*ON AFFICHE L'ÉCRAN POUR RÉCUP LA BIBL &SAVLIB */
             SNDRCVF

             CHGVAR     VAR(&IN50) VALUE('0')
             IF         COND(&IN03 = '1') THEN(GOTO CMDLBL(END))

 /*ON RÉCUPÈRE LA DATE SYSTÈME ET ON LA MET DANS LA VARIABLE DATE */
             RTVSYSVAL  SYSVAL(QDATE) RTNVAR(&DATE)
             CHGVAR     VAR(&SAVENAME) VALUE(%TRIM(&SAVBIB) *CAT '-' +
                          *CAT &DATE *CAT '.SAVF')

 /*ON RÉCUPÈRE LE USER */
             RTVUSRPRF  RTNUSRPRF(&USER)
 /*ON MODIFIE LA DESTINATION ET LE PATH(DIR) GRÂCE AU DONNÉES RÉCUP */
             CHGVAR     VAR(&DEST) VALUE('/HOME/' *TCAT &USER *TCAT +
                          '/' *TCAT &SAVENAME)
             CHGVAR     VAR(&DIR) VALUE('/HOME/' *TCAT &USER)
 /*ON CRÉE LE PATH */
             CRTDIR     DIR(&DIR)
             MONMSG     MSGID(CPFA0A0)

 /*ON SUPPRIME LE FICHIER LIBSAVF S'IL EXISTE DEJA PUIS ON LE CRÉE */
             DLTOBJ     OBJ(QTEMP/LIBSAVF) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF2105)
             CRTSAVF    FILE(QTEMP/LIBSAVF)
 /*ON SAUVEGARDE LA BIBL DANS LE FICHIER ET SI ERREUR ON RETOURNE +
   A LOOP */
             SAVLIB     LIB(&SAVBIB) DEV(*SAVF) SAVF(QTEMP/LIBSAVF)
             MONMSG     MSGID(CPF3781 CPF0001) EXEC(DO)
                 CHGVAR     VAR(&IN50) VALUE('1')
                 GOTO       CMDLBL(LOOP)
             ENDDO

/*ON COPIE LE FICHIER DANS LA DESTINATION QU'ON A RENSEIGNÉE */
             CPYTOSTMF FROMMBR('/QSYS.LIB/QTEMP.LIB/LIBSAVF.FILE') +
                       TOSTMF(&DEST) STMFOPT(*REPLACE) CVTDTA(*NONE)
 /*ON CHANGE LA VARIABLE SUCCESS POUR AFFICHER LE MESSAGE DE SUCCÈS*/
             CHGVAR     VAR(&SUCCESS) VALUE('FICHIER' *BCAT +
                          &SAVENAME *BCAT 'CRÉÉ !')
 /*ON RETOURNE À LA LOOP POUR FAIRE UNE AUTRE SAUVEGARDE */
             GOTO       CMDLBL(LOOP)


 END:        ENDPGM
